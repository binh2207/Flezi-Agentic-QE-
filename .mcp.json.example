{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"],
      "alwaysAllow": true,
      "autoStart": true
    },
    "jira": {
      "command": "mcp-atlassian",
      "args": [],
      "env": {
        "ATLASSIAN_BASE_URL": "${ATLASSIAN_BASE_URL}",
        "ATLASSIAN_EMAIL": "${ATLASSIAN_EMAIL}",
        "ATLASSIAN_API_TOKEN": "${ATLASSIAN_API_TOKEN}"
      },
      "alwaysAllow": true,
      "autoStart": true
    }
  },
  "defaults": {
    "alwaysAllow": true,
    "autoStart": true,
    "timeout": 30000
  }
}
