{
  "name": "aiqe-playwright-harness-engineering",
  "version": "2.0.0",
  "private": true,
  "description": "Application-agnostic AI harness engineering core for Playwright automation",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "scripts": {
    "test": "npm run test --prefix playwright-automation-framework",
    "test:headed": "npm run test:headed --prefix playwright-automation-framework",
    "test:smoke": "npm run test:smoke --prefix playwright-automation-framework",
    "test:regression": "npm run test:regression --prefix playwright-automation-framework",
    "test:debug": "npm run test:debug --prefix playwright-automation-framework",
    "report": "npm run report --prefix playwright-automation-framework",
    "kb:serve": "python kb_server/web_app.py",
    "setup": "bash scripts/setup.sh",
    "setup:playwright": "bash scripts/setup-playwright.sh && bash scripts/setup-mcp.sh",
    "setup:mcp": "bash scripts/setup-mcp.sh",
    "verify:mcp": "bash scripts/verify-mcp-playwright.sh",
    "setup:kb": "bash scripts/setup-kb.sh",
    "setup:claudecode": "bash scripts/setup-assistant.sh claudecode",
    "setup:cursor": "bash scripts/setup-assistant.sh cursor",
    "setup:copilot": "bash scripts/setup-assistant.sh copilot",
    "setup:assistants": "bash scripts/setup-assistant.sh all",
    "setup:playwright:win": "powershell -ExecutionPolicy Bypass -File scripts/setup-playwright.ps1",
    "verify:mcp:win": "powershell -ExecutionPolicy Bypass -File scripts/verify-mcp-playwright.ps1",
    "setup:claudecode:win": "powershell -ExecutionPolicy Bypass -File scripts/setup-assistant.ps1 claudecode",
    "setup:cursor:win": "powershell -ExecutionPolicy Bypass -File scripts/setup-assistant.ps1 cursor",
    "setup:copilot:win": "powershell -ExecutionPolicy Bypass -File scripts/setup-assistant.ps1 copilot",
    "setup:assistants:win": "powershell -ExecutionPolicy Bypass -File scripts/setup-assistant.ps1 all",
    "harness-mcp": "node scripts/harness-mcp-server.js",
    "typecheck": "npm run typecheck --prefix playwright-automation-framework"
  }
}
